{
  "name": "outbound-motherduck-data-dive",
  "version": "0.0.0",
  "private": true,
  "description": "Pulls every client's outbound data through outbound-sdk into DuckDB or MotherDuck, and builds a one-page report from SQL.",
  "type": "module",
  "scripts": {
    "demo": "node src/load.ts --demo && node src/report.ts",
    "load": "node src/load.ts",
    "report": "node src/report.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@duckdb/node-api": "1.4.5-r.1",
    "outbound-sdk": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
