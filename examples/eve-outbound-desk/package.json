{
  "name": "outbound-desk",
  "version": "0.0.0",
  "private": true,
  "description": "An eve agent for an outbound agency: answers campaign questions in Slack and posts weekly client reports, through outbound-sdk.",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "OUTBOUND_SDK_PROVIDER=memory eve eval",
    "start": "eve start",
    "typecheck": "tsc",
    "demo": "OUTBOUND_SDK_PROVIDER=memory eve dev"
  },
  "dependencies": {
    "ai": "^7.0.172",
    "eve": "^1.0.0-rc.18",
    "outbound-sdk": "latest",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.x",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26.x"
  }
}
