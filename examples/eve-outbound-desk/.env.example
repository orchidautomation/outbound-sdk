# Copy to .env.local for `eve dev`, and set the same values in your host's
# environment for a deployment.

# The model. With AI Gateway (the default "anthropic/..." model string):
AI_GATEWAY_API_KEY=

# Slack (portable credentials). See README.md for the app's scopes and events.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# The team's internal channel, for the weekday morning check.
OUTBOUND_OPS_CHANNEL_ID=

# One API key per client, named as agent/lib/clients.ts says. The SDK only
# reads, so use a read-only key where the vendor offers one.
ACME_INSTANTLY_API_KEY=
GLOBEX_HEYREACH_API_KEY=

# Or skip the keys and use made-up data (agent/lib/demo.ts):
# OUTBOUND_SDK_PROVIDER=memory
