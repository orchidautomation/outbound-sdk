{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "outbound-sdk": ["./packages/outbound-sdk/src/index.ts"],
      "outbound-sdk/tools/ai-sdk": [
        "./packages/outbound-sdk/src/tools/ai-sdk.ts"
      ],
      "outbound-sdk/tools/claude-agent": [
        "./packages/outbound-sdk/src/tools/claude-agent.ts"
      ],
      "outbound-sdk/*": ["./packages/outbound-sdk/src/*/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "site/content/_examples",
    "site/test",
    "skills",
    "evals"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
